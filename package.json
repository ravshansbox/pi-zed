{
  "name": "@ravshansbox/pi-zed",
  "version": "0.0.0",
  "description": "Zed editor context extension for pi",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravshansbox/pi-zed.git"
  },
  "homepage": "https://github.com/ravshansbox/pi-zed#readme",
  "bugs": {
    "url": "https://github.com/ravshansbox/pi-zed/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "zed"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
