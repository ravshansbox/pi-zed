{
  "name": "@ravshansbox/pi-zed",
  "version": "0.1.0",
  "description": "pi extension that reads zed's open files and selected lines and injects them into prompts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravshansbox/pi-zed.git"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/ravshansbox/pi-zed#readme",
  "bugs": {
    "url": "https://github.com/ravshansbox/pi-zed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "zed"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck"
  }
}
